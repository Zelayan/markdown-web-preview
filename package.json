{
  "name": "@zelayan/markdown-web-preview",
  "version": "0.4.3",
  "type": "module",
  "description": "Markdown web preview for DeepSeek Harness document tabs",
  "license": "MIT",
  "author": "Zelayan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zelayan/markdown-web-preview.git"
  },
  "homepage": "https://github.com/Zelayan/markdown-web-preview#readme",
  "bugs": {
    "url": "https://github.com/Zelayan/markdown-web-preview/issues"
  },
  "keywords": [
    "markdown",
    "preview",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "vscode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib/client.js",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:harness": "node scripts/build.mjs harness",
    "build:vscode": "node scripts/build.mjs vscode",
    "package": "node scripts/package-offline.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "install:offline": "node scripts/install-offline.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/verify-mermaid.mjs"
  },
  "devDependencies": {
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "marked": "^15.0.0",
    "mermaid": "^11.17.2",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {}
}
