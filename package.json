{
  "name": "@local/markdown-web-preview",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "Markdown web preview for DeepSeek Harness document tabs",
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib/client.js",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:harness": "esbuild src/client.js --bundle --platform=browser --format=iife --target=es2022 --outfile=lib/client.js",
    "build:vscode": "esbuild src/vscode-webview.js --bundle --platform=browser --format=iife --target=es2022 --outfile=vscode/webview.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "marked": "^15.0.0"
  }
}
